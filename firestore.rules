rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Malwa Concrete Factory Operations - Realtime sync across all devices
    match /malwa_tasks/{taskId} {
      allow read, write: if true;
    }
    match /malwa_routines/{routineId} {
      allow read, write: if true;
    }
    match /malwa_employees/{employeeId} {
      allow read, write: if true;
    }
    match /malwa_settings/{settingId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
