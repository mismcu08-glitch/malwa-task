{
  "id": "malwa-concrete-fms-portal",
  "name": "Malwa Concrete FMS - Task Hub",
  "short_name": "Malwa FMS",
  "description": "Factory Operations, SLA Tracking & Real-Time Task Delegation Portal for Malwa Concrete Udyog Pvt. Ltd.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#0b2533",
  "theme_color": "#0b2533",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "business",
    "productivity",
    "utilities"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://malwa-task.vercel.app/manifest.json"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://malwa-task.vercel.app"
    }
  ],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Malwa Concrete Operations Dashboard on Desktop"
    },
    {
      "src": "/screenshot-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Task Delegation & Routine Hub on Mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Task Hub",
      "short_name": "Tasks",
      "description": "View active task list and SLA deadlines",
      "url": "/?view=tasks",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Delegate Task",
      "short_name": "Delegate",
      "description": "Assign a new factory task or routine",
      "url": "/?view=delegate",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+malwafms",
      "url": "/?task=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/?action=open-file",
      "name": "Malwa FMS Data Files",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ],
      "accept": {
        "text/csv": [".csv"],
        "application/json": [".json"]
      }
    }
  ],
  "share_target": {
    "action": "/?action=share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "note_taking": {
    "new_note_url": "/?action=new-task"
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "widgets": [
    {
      "name": "Malwa Task Summary",
      "short_name": "TaskWidget",
      "description": "Quick view of urgent pending factory tasks",
      "tag": "task-summary",
      "template": "widget-template",
      "ms_ac_template": "widget-template.json",
      "data": "widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-mobile.png",
          "sizes": "750x1334",
          "label": "Widget View"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
